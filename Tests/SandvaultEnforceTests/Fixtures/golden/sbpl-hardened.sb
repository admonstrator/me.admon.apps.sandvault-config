;; Generated by Sandvault Config (svctl rules). Last match wins: these rules override sv's above.
;; preset hardened (opt-in, conservative; verify on a real Mac)
;; hardened: AppleScript/JXA can drive GUI apps of the logged-in session
(deny process-exec (literal "/usr/bin/osascript"))
;; hardened: builds AppleScript applets that run outside the sandbox when opened
(deny process-exec (literal "/usr/bin/osacompile"))
;; hardened: runs Automator workflows, which script GUI apps like osascript
(deny process-exec (literal "/usr/bin/automator"))
;; hardened: runs Shortcuts, which execute in the Shortcuts service outside the sandbox
(deny process-exec (literal "/usr/bin/shortcuts"))
;; hardened: asks LaunchServices to open apps, files and URLs in the logged-in session
(deny process-exec (literal "/usr/bin/open"))
;; hardened: submits launchd jobs, which start without the sandbox-exec profile
(deny process-exec (literal "/bin/launchctl"))
;; hardened: captures the screen of the logged-in session
(deny process-exec (literal "/usr/sbin/screencapture"))
;; hardened: resets privacy (TCC) decisions
(deny process-exec (literal "/usr/bin/tccutil"))
;; hardened: reconfigures interfaces, DNS and proxies
(deny process-exec (literal "/usr/sbin/networksetup"))
;; hardened: changes system settings (remote login, time, power)
(deny process-exec (literal "/usr/sbin/systemsetup"))
;; hardened: reads and edits accounts and groups in the directory service
(deny process-exec (literal "/usr/bin/dscl"))
;; hardened: clipboard of the logged-in session (read secrets, plant commands)
(deny mach-lookup (global-name "com.apple.pasteboard.1"))
;; hardened: LaunchServices: opens apps, documents and URLs for the caller
(deny mach-lookup (global-name "com.apple.coreservices.launchservicesd"))
;; hardened: Apple Events to other apps (sv denies com.apple.appleeventsd)
(deny mach-lookup (global-name "com.apple.coreservices.appleevents"))
;; rule 00000000-0000-4000-8000-000000000007: agent may open URLs
(allow process-exec (literal "/usr/bin/open"))
